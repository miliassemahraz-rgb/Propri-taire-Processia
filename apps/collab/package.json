{
  "name": "@processia/collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Serveur de coédition Yjs fondé sur Hocuspocus (WP-10)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hocuspocus/server": "3.4.4",
    "@processia/config": "workspace:*",
    "@processia/contracts": "workspace:*",
    "@processia/db": "workspace:*",
    "@processia/model": "workspace:*",
    "@processia/policy": "workspace:*",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsc-watch": "7.2.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js"
}
