{
  "name": "@processia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API NestJS : point d'entrée HTTP (main.ts) et worker de tâches (worker.ts)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "dev:worker": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/worker.js\"",
    "dev:totp": "node --env-file-if-exists=../../.env dist/cli/dev-totp.js",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1178.0",
    "@aws-sdk/s3-request-presigner": "3.1178.0",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "@node-rs/argon2": "2.2.2",
    "@processia/ai": "workspace:*",
    "@processia/bpmn": "workspace:*",
    "@processia/config": "workspace:*",
    "@processia/contracts": "workspace:*",
    "@processia/db": "workspace:*",
    "@processia/exports": "workspace:*",
    "@processia/i18n": "workspace:*",
    "@processia/ingest": "workspace:*",
    "@processia/model": "workspace:*",
    "@processia/policy": "workspace:*",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.18",
    "nodemailer": "10.6.1",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "pg-boss": "12.40.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "3.4.4",
    "@nestjs/testing": "11.2.12",
    "@processia/collab": "workspace:*",
    "@processia/test-fixtures": "workspace:*",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "exceljs": "4.4.0",
    "mammoth": "1.13.0",
    "tsc-watch": "7.2.1",
    "unpdf": "2.2.3",
    "ws": "8.23.0"
  }
}
