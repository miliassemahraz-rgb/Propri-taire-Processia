{
  "name": "@processia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle : schéma, migrations, RLS, seed (WP-04)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "tsc -p tsconfig.build.json && node scripts/migrate.mjs",
    "db:seed": "tsc -p tsconfig.build.json && node scripts/seed.mjs",
    "e2e:prepare": "tsc -p tsconfig.build.json && node scripts/e2e-prepare.mjs"
  },
  "dependencies": {
    "@processia/config": "workspace:*",
    "@processia/model": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@processia/config": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
