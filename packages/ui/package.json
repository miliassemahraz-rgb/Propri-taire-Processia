{
  "name": "@processia/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Composants accessibles (React Aria Components) et thème (WP-07)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@processia/i18n": "workspace:*",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@processia/config": "workspace:*",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0"
  }
}
