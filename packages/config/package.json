{
  "name": "@processia/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Configuration partagée : tsconfig, ESLint, Prettier, schéma des variables d'environnement",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./eslint": "./eslint/index.mjs",
    "./prettier": "./prettier/index.mjs",
    "./tsconfig/*": "./tsconfig/*"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "typescript-eslint": "8.74.0",
    "zod": "4.6.7"
  }
}
