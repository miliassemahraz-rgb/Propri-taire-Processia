{
  "name": "@processia/model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Méta-modèle : schémas zod, types, opérations, cohérence, complétude, vues. Pur, sans E/S (WP-02, WP-03)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "schema:export": "tsx src/scripts/export-schema.ts && prettier --write schema fixtures"
  },
  "devDependencies": {
    "@processia/config": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "files": [
    "dist",
    "schema",
    "fixtures"
  ]
}
