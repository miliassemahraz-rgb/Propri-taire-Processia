# Copier vers .env pour le développement local : `cp .env.example .env`.
# Ces valeurs sont réservées au développement local ; ne jamais y mettre de vrai secret.
# Toute variable lue par le code est validée par packages/config/src/env.ts.

NODE_ENV=development

# --- PostgreSQL (docker compose : service "postgres") ---
POSTGRES_USER=processia
POSTGRES_PASSWORD=processia
DATABASE_URL=postgres://processia:processia@localhost:5432/processia
DATABASE_TEST_URL=postgres://processia:processia@localhost:5432/processia_test
DATABASE_OWNER_URL=postgres://processia_owner:processia_owner@localhost:5432/processia
DATABASE_APP_URL=postgres://processia_app:processia_app@localhost:5432/processia

# --- Stockage S3 (docker compose : service "minio") ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=processia
S3_SECRET_KEY=processia-dev-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_SOURCES=processia-sources
S3_BUCKET_ARTIFACTS=processia-artifacts

# --- Courrier (docker compose : service "mailpit", interface sur http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Processia <no-reply@processia.local>"

# --- Services applicatifs ---
WEB_PORT=3000
API_PORT=3001
COLLAB_PORT=3002
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# --- Secrets applicatifs (32 caractères minimum ; à remplacer hors développement local) ---
SESSION_SECRET=dev-only-session-secret-change-me-0000
COLLAB_JWT_SECRET=dev-only-collab-secret-change-me-00000
MASTER_KEY=dev-only-master-key-change-me-0000000

# --- Couche IA : fournisseur factice par défaut (aucune clé requise) ---
AI_PROVIDER=fake
# ANTHROPIC_API_KEY=
