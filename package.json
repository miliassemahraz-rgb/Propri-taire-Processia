{
  "name": "processia",
  "version": "0.0.0",
  "private": true,
  "description": "Processia : analyse et cartographie des processus métier (incrément 1)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "e2e": "pnpm --filter @processia/web build && pnpm --filter @processia/e2e test",
    "db:migrate": "pnpm --filter @processia/db db:migrate",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@processia/config": "workspace:*",
    "@types/node": "22.20.7",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
