{
  "name": "processia",
  "version": "0.0.0",
  "private": true,
  "description": "Processia : analyse et cartographie des processus métier (incrément 1)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage:model": "vitest run packages/model --coverage --coverage.provider=v8 --coverage.include=packages/model/src/schema/** --coverage.exclude=**/*.test.ts --coverage.exclude=**/index.ts --coverage.thresholds.lines=90 --coverage.thresholds.statements=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90",
    "test:int": "vitest run --config vitest.int.config.ts",
    "e2e": "turbo run build --filter=@processia/web --filter=@processia/api --filter=@processia/collab && pnpm --filter @processia/e2e test",
    "ai:smoke": "pnpm --filter @processia/ai build && node --env-file-if-exists=.env packages/ai/dist/smoke.js",
    "db:migrate": "pnpm --filter @processia/db db:migrate",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate && pnpm db:seed",
    "db:seed": "pnpm --filter @processia/db db:seed",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@processia/config": "workspace:*",
    "@types/node": "22.20.7",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
